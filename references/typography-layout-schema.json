{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "font-visual-design-01.typography-layout.schema.json",
  "title": "Typography layout plan",
  "type": "object",
  "required": [
    "schema_version",
    "canvas",
    "assets",
    "intent",
    "title_area",
    "text_blocks",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "candidate_id": {
      "type": "string",
      "description": "Stable candidate id such as candidate-01."
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "coordinate_system"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "coordinate_system": {"type": "string", "const": "relative-0-1"}
      }
    },
    "assets": {
      "type": "object",
      "required": ["background_path", "font_path"],
      "properties": {
        "background_path": {"type": "string"},
        "font_path": {"type": "string"},
        "metadata_path": {"type": "string"},
        "preview_path": {"type": "string"},
        "surface_analysis_path": {"type": "string"}
      }
    },
    "intent": {
      "type": "object",
      "required": ["style", "theme", "primary_copy"],
      "properties": {
        "style": {"type": "string", "enum": ["font-poster", "ecommerce-banner", "product-application"]},
        "theme": {"type": "string"},
        "primary_copy": {"type": "string"},
        "secondary_copy": {"type": "string"},
        "mood": {"type": "array", "items": {"type": "string"}}
      }
    },
    "title_area": {
      "$ref": "#/$defs/rect",
      "description": "Recommended title-safe region in relative coordinates."
    },
    "subject_exclusion_zone": {
      "$ref": "#/$defs/rect",
      "description": "No-text zone covering the full recognizable subject plus required clearance."
    },
        "text_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/text_block"}
    },
        "constraints": {
      "type": "object",
      "required": ["local_font_only", "no_ai_redraw", "no_glyph_deformation"],
      "properties": {
        "local_font_only": {"type": "boolean", "const": true},
        "no_ai_redraw": {"type": "boolean", "const": true},
        "no_glyph_deformation": {"type": "boolean", "const": true},
        "max_iterations": {"type": "integer", "const": 3},
        "pass_threshold": {"type": "number", "const": 82}
      }
    },
        "notes_for_reviewer": {
      "type": "string"
    },
    "surface_context": {
      "type": "object",
      "description": "Optional product-application surface analysis copied or summarized from surface-analyzer-schema.json.",
      "properties": {
        "target_surface_id": {"type": "string"},
        "surface_analysis_path": {"type": "string"},
        "surface_type": {"type": "string"},
        "surface_role": {"type": "string"},
        "material": {"type": "string"},
        "perspective": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "w": {"type": "number", "minimum": 0, "maximum": 1},
        "h": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "rgba": {
      "type": "object",
      "required": ["hex"],
      "properties": {
        "hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1, "default": 1}
      }
    },
    "text_block": {
      "type": "object",
      "required": [
        "id",
        "role",
        "text",
        "font_path",
        "position",
        "font_size",
        "color"
      ],
      "properties": {
        "id": {"type": "string"},
        "role": {
          "type": "string",
          "enum": ["title", "subtitle", "caption", "tag"]
        },
        "text": {"type": "string", "minLength": 1},
        "font_path": {"type": "string"},
        "position": {"$ref": "#/$defs/point"},
        "font_size": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Font size relative to canvas height."
        },
        "color": {"$ref": "#/$defs/rgba"},
        "rotation": {
          "type": "number",
          "minimum": -25,
          "maximum": 25,
          "default": 0
        },
        "scale": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 2,
          "default": 1,
          "description": "Uniform scale only; never use separate x/y scale."
        },
        "line_breaks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "direction": {
          "type": "string",
          "enum": ["horizontal", "vertical", "free"],
          "default": "horizontal"
        },
        "align": {
          "type": "string",
          "enum": ["left", "center", "right"],
          "default": "left",
          "description": "Horizontal anchor applied to position.x using the rendered line width."
        },
        "letter_spacing": {
          "type": "number",
          "minimum": -0.05,
          "maximum": 0.2,
          "default": 0,
          "description": "Relative to canvas width."
        },
        "line_spacing": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "default": 0.02,
          "description": "Relative to canvas height."
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "shadow": {
          "type": "object",
          "properties": {
            "color": {"$ref": "#/$defs/rgba"},
            "dx": {"type": "number", "minimum": -0.05, "maximum": 0.05},
            "dy": {"type": "number", "minimum": -0.05, "maximum": 0.05},
            "blur": {"type": "number", "minimum": 0, "maximum": 0.05}
          }
        },
        "chars": {
          "type": "array",
          "items": {"$ref": "#/$defs/char_adjustment"},
          "description": "Optional per-character overrides. Character order maps to the text without line breaks."
        },
        "surface_binding": {
          "$ref": "#/$defs/surface_binding",
          "description": "For product-application layouts, bind this text block to a physical surface."
        },
        "material_effect": {
          "$ref": "#/$defs/material_effect",
          "description": "Material treatment applied after local font rendering and optional surface mapping."
        }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "char_adjustment": {
      "type": "object",
      "required": ["index"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "char": {"type": "string", "maxLength": 2},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "scale": {"type": "number", "minimum": 0.2, "maximum": 2},
        "rotation": {"type": "number", "minimum": -25, "maximum": 25},
        "color": {"$ref": "#/$defs/rgba"}
      },
      "additionalProperties": false
    },
    "quad": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "number", "minimum": 0, "maximum": 1},
          {"type": "number", "minimum": 0, "maximum": 1}
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "surface_binding": {
      "type": "object",
      "required": ["surface_id", "mapping"],
      "properties": {
        "surface_id": {"type": "string"},
        "mapping": {
          "type": "string",
          "enum": ["none", "homography", "quad", "local_label", "segmented"]
        },
        "target_quad": {
          "$ref": "#/$defs/quad",
          "description": "Optional override target quad: top_left, top_right, bottom_right, bottom_left."
        },
        "safe_area_policy": {
          "type": "string",
          "enum": ["must_stay_inside", "may_bleed_by_2_percent", "user_override"],
          "default": "must_stay_inside"
        },
        "perspective_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "material_effect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["flat_color", "ink_on_paper", "gold_foil", "embossed_paper", "debossed_paper", "silkscreen", "glass_label"]
        },
        "base_color": {"$ref": "#/$defs/rgba"},
        "texture_strength": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.18},
        "highlight_strength": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.16},
        "shadow_strength": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.12},
        "emboss_depth": {"type": "number", "minimum": 0, "maximum": 0.08, "default": 0.015},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1, "default": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
